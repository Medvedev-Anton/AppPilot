    {
      "parameters": {
        "jsCode": "const messages = $input.all();\n\nif (!messages.length) {\n  throw new Error(\"No LLM output received\");\n}\n\nconst msg = messages[0].json;\nlet rawText = msg.text;\n\nif (typeof rawText !== \"string\") {\n  throw new Error(\"LLM output is not a string\");\n}\n\n// Убираем markdown на всякий случай\nrawText = rawText\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Парсим JSON\nlet project;\ntry {\n  project = JSON.parse(rawText);\n} catch (e) {\n  throw new Error(\"Failed to parse JSON from LLM\");\n}\n\n// ЖЁСТКАЯ ВАЛИДАЦИЯ (и это нормально)\nif (\n  !project.projectName ||\n  !Array.isArray(project.files)\n) {\n  throw new Error(\"Invalid React project schema\");\n}\n\n// Проверяем ключевые файлы\nconst requiredFiles = [\n  \"index.html\",\n  \"src/main.tsx\",\n  \"src/App.tsx\"\n];\n\nfor (const file of requiredFiles) {\n  if (!project.files.some(f => f.path === file)) {\n    throw new Error(`Missing required file: ${file}`);\n  }\n}\n\nreturn { project };\n"
      },
